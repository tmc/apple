+
+func (c *clientFile) xattr(attr string) ([]byte, error) {
+	if atomic.LoadUint32(&c.closed) != 0 {
+		return nil, linux.EBADF
+	}
+	id, ok := c.client.fidPool.Get()
+	if !ok {
+		return nil, ErrOutOfFIDs
+	}
+	xfid := fid(id)
+	var walk rxattrwalk
+	if err := c.client.sendRecv(&txattrwalk{fid: c.fid, newFID: xfid, Name: attr}, &walk); err != nil {
+		c.client.fidPool.Put(id)
+		return nil, err
+	}
+	xfile := c.client.newFile(xfid)
+	defer xfile.Close()
+	if walk.Size == 0 {
+		return nil, nil
+	}
+	data := make([]byte, walk.Size)
+	n, err := xfile.ReadAt(data, 0)
+	if err != nil && err != io.EOF {
+		return nil, err
+	}
+	return data[:n], nil
 }

 // Walk implements File.Walk.
