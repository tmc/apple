program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3510.2.1"}, {"coremlc-version", "3505.4.1"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<ios18>(tensor<fp32, [1, 1, 8]> x_in, state<tensor<fp16, [1,2,4,4]>> l0_k_cache_state, state<tensor<fp16, [1,2,4,4]>> l0_v_cache_state) {
        string to_fp16 = const()[name=string("to_fp16"), val=string("fp16")];
        tensor<fp16, [1,1,8]> x = cast(dtype=to_fp16, x=x_in)[name=string("cast_in")];
        int32 cache_axis = const()[name=string("cache_axis"), val=int32(2)];
        bool cache_interleave = const()[name=string("cache_interleave"), val=bool(false)];
        tensor<int32, [4]> cache_tail_begin = const()[name=string("cache_tail_begin"), val=tensor<int32, [4]>([0,0,1,0])];
        tensor<int32, [4]> cache_tail_end = const()[name=string("cache_tail_end"), val=tensor<int32, [4]>([0,0,0,0])];
        tensor<bool, [4]> cache_tail_begin_mask = const()[name=string("cache_tail_begin_mask"), val=tensor<bool, [4]>([true,true,false,true])];
        tensor<bool, [4]> cache_tail_end_mask = const()[name=string("cache_tail_end_mask"), val=tensor<bool, [4]>([true,true,true,true])];
        tensor<fp16, [8, 8]> l0_q_w = const()[name=string("l0_q_w"), val=tensor<fp16, [8, 8]>(BLOBFILE(path=string("@model_path/weights/l0_q_w.bin"), offset=uint64(64)))];
        tensor<fp16, [8]> l0_q_b = const()[name=string("l0_q_b"), val=tensor<fp16, [8]>(BLOBFILE(path=string("@model_path/weights/l0_q_b.bin"), offset=uint64(64)))];
        tensor<fp16, [8, 8]> l0_k_w = const()[name=string("l0_k_w"), val=tensor<fp16, [8, 8]>(BLOBFILE(path=string("@model_path/weights/l0_k_w.bin"), offset=uint64(64)))];
        tensor<fp16, [8]> l0_k_b = const()[name=string("l0_k_b"), val=tensor<fp16, [8]>(BLOBFILE(path=string("@model_path/weights/l0_k_b.bin"), offset=uint64(64)))];
        tensor<fp16, [8, 8]> l0_v_w = const()[name=string("l0_v_w"), val=tensor<fp16, [8, 8]>(BLOBFILE(path=string("@model_path/weights/l0_v_w.bin"), offset=uint64(64)))];
        tensor<fp16, [8]> l0_v_b = const()[name=string("l0_v_b"), val=tensor<fp16, [8]>(BLOBFILE(path=string("@model_path/weights/l0_v_b.bin"), offset=uint64(64)))];
        tensor<fp16, [8, 8]> l0_o_w = const()[name=string("l0_o_w"), val=tensor<fp16, [8, 8]>(BLOBFILE(path=string("@model_path/weights/l0_o_w.bin"), offset=uint64(64)))];
        tensor<fp16, [8]> l0_o_b = const()[name=string("l0_o_b"), val=tensor<fp16, [8]>(BLOBFILE(path=string("@model_path/weights/l0_o_b.bin"), offset=uint64(64)))];
        tensor<fp16, [16, 8]> l0_w1 = const()[name=string("l0_w1"), val=tensor<fp16, [16, 8]>(BLOBFILE(path=string("@model_path/weights/l0_w1.bin"), offset=uint64(64)))];
        tensor<fp16, [16]> l0_b1 = const()[name=string("l0_b1"), val=tensor<fp16, [16]>(BLOBFILE(path=string("@model_path/weights/l0_b1.bin"), offset=uint64(64)))];
        tensor<fp16, [16, 8]> l0_w3 = const()[name=string("l0_w3"), val=tensor<fp16, [16, 8]>(BLOBFILE(path=string("@model_path/weights/l0_w3.bin"), offset=uint64(64)))];
        tensor<fp16, [16]> l0_b3 = const()[name=string("l0_b3"), val=tensor<fp16, [16]>(BLOBFILE(path=string("@model_path/weights/l0_b3.bin"), offset=uint64(64)))];
        tensor<fp16, [8, 16]> l0_w2 = const()[name=string("l0_w2"), val=tensor<fp16, [8, 16]>(BLOBFILE(path=string("@model_path/weights/l0_w2.bin"), offset=uint64(64)))];
        tensor<fp16, [8]> l0_b2 = const()[name=string("l0_b2"), val=tensor<fp16, [8]>(BLOBFILE(path=string("@model_path/weights/l0_b2.bin"), offset=uint64(64)))];
        tensor<fp16, [1,1,8]> l0_in_norm_abs = abs(x=x)[name=string("l0_in_norm_abs")];
        tensor<int32, [1]> l0_in_norm_ax = const()[name=string("l0_in_norm_ax"), val=tensor<int32, [1]>([2])];
        bool l0_in_norm_kd = const()[name=string("l0_in_norm_kd"), val=bool(true)];
        tensor<fp16, [1,1,1]> l0_in_norm_maxabs = reduce_max(x=l0_in_norm_abs, axes=l0_in_norm_ax, keep_dims=l0_in_norm_kd)[name=string("l0_in_norm_maxabs")];
        fp16 l0_in_norm_eps = const()[name=string("l0_in_norm_eps"), val=fp16(0.000010)];
        tensor<fp16, [1,1,1]> l0_in_norm_safemax = maximum(x=l0_in_norm_maxabs, y=l0_in_norm_eps)[name=string("l0_in_norm_safemax")];
        tensor<fp16, [1,1,8]> l0_in_norm_scaled = real_div(x=x, y=l0_in_norm_safemax)[name=string("l0_in_norm_scaled")];
        tensor<fp16, [1,1,8]> l0_in_norm_square = square(x=l0_in_norm_scaled)[name=string("l0_in_norm_square")];
        tensor<fp16, [1,1,1]> l0_in_norm_meansq = reduce_mean(x=l0_in_norm_square, axes=l0_in_norm_ax, keep_dims=l0_in_norm_kd)[name=string("l0_in_norm_meansq")];
        tensor<fp16, [1,1,1]> l0_in_norm_meaneps = add(x=l0_in_norm_meansq, y=l0_in_norm_eps)[name=string("l0_in_norm_meaneps")];
        tensor<fp16, [1,1,1]> l0_in_norm_rms = sqrt(x=l0_in_norm_meaneps)[name=string("l0_in_norm_rms")];
        tensor<fp16, [1,1,1]> l0_in_norm_scaledrms = mul(x=l0_in_norm_rms, y=l0_in_norm_safemax)[name=string("l0_in_norm_scaledrms")];
        tensor<fp16, [1,1,8]> l0_in_norm_norm = real_div(x=x, y=l0_in_norm_scaledrms)[name=string("l0_in_norm_norm")];
        tensor<fp16, [1,1,8]> l0_in_norm_rw = const()[name=string("l0_in_norm_rw"), val=tensor<fp16, [1,1,8]>(BLOBFILE(path=string("@model_path/weights/l0_input_norm.bin"), offset=uint64(64)))];
        tensor<fp16, [1,1,8]> l0_in_norm_out = mul(x=l0_in_norm_norm, y=l0_in_norm_rw)[name=string("l0_in_norm_out")];
        tensor<fp16, [1,1,8]> l0_q_flat = linear(bias=l0_q_b, weight=l0_q_w, x=l0_in_norm_out)[name=string("l0_q_flat")];
        tensor<fp16, [1,1,8]> l0_k_flat = linear(bias=l0_k_b, weight=l0_k_w, x=l0_in_norm_out)[name=string("l0_k_flat")];
        tensor<fp16, [1,1,8]> l0_v_flat = linear(bias=l0_v_b, weight=l0_v_w, x=l0_in_norm_out)[name=string("l0_v_flat")];
        tensor<int32, [4]> l0_qsh = const()[name=string("l0_qsh"), val=tensor<int32, [4]>([1,2,1,4])];
        tensor<int32, [3]> l0_osh = const()[name=string("l0_osh"), val=tensor<int32, [3]>([1,1,8])];
        tensor<fp16, [1,2,1,4]> l0_q_4d = reshape(shape=l0_qsh, x=l0_q_flat)[name=string("l0_q_4d")];
        tensor<fp16, [1,2,1,4]> l0_k_4d = reshape(shape=l0_qsh, x=l0_k_flat)[name=string("l0_k_4d")];
        tensor<fp16, [1,2,1,4]> l0_v_4d = reshape(shape=l0_qsh, x=l0_v_flat)[name=string("l0_v_4d")];
        tensor<fp16, [1,2,1,4]> l0_q_norm_abs = abs(x=l0_q_4d)[name=string("l0_q_norm_abs")];
        tensor<int32, [1]> l0_q_norm_ax = const()[name=string("l0_q_norm_ax"), val=tensor<int32, [1]>([3])];
        bool l0_q_norm_kd = const()[name=string("l0_q_norm_kd"), val=bool(true)];
        tensor<fp16, [1,2,1,1]> l0_q_norm_maxabs = reduce_max(x=l0_q_norm_abs, axes=l0_q_norm_ax, keep_dims=l0_q_norm_kd)[name=string("l0_q_norm_maxabs")];
        fp16 l0_q_norm_eps = const()[name=string("l0_q_norm_eps"), val=fp16(0.000010)];
        tensor<fp16, [1,2,1,1]> l0_q_norm_safemax = maximum(x=l0_q_norm_maxabs, y=l0_q_norm_eps)[name=string("l0_q_norm_safemax")];
        tensor<fp16, [1,2,1,4]> l0_q_norm_scaled = real_div(x=l0_q_4d, y=l0_q_norm_safemax)[name=string("l0_q_norm_scaled")];
        tensor<fp16, [1,2,1,4]> l0_q_norm_square = square(x=l0_q_norm_scaled)[name=string("l0_q_norm_square")];
        tensor<fp16, [1,2,1,1]> l0_q_norm_meansq = reduce_mean(x=l0_q_norm_square, axes=l0_q_norm_ax, keep_dims=l0_q_norm_kd)[name=string("l0_q_norm_meansq")];
        tensor<fp16, [1,2,1,1]> l0_q_norm_meaneps = add(x=l0_q_norm_meansq, y=l0_q_norm_eps)[name=string("l0_q_norm_meaneps")];
        tensor<fp16, [1,2,1,1]> l0_q_norm_rms = sqrt(x=l0_q_norm_meaneps)[name=string("l0_q_norm_rms")];
        tensor<fp16, [1,2,1,1]> l0_q_norm_scaledrms = mul(x=l0_q_norm_rms, y=l0_q_norm_safemax)[name=string("l0_q_norm_scaledrms")];
        tensor<fp16, [1,2,1,4]> l0_q_norm_norm = real_div(x=l0_q_4d, y=l0_q_norm_scaledrms)[name=string("l0_q_norm_norm")];
        tensor<fp16, [1,1,1,4]> l0_q_norm_rw = const()[name=string("l0_q_norm_rw"), val=tensor<fp16, [1,1,1,4]>(BLOBFILE(path=string("@model_path/weights/l0_q_norm.bin"), offset=uint64(64)))];
        tensor<fp16, [1,2,1,4]> l0_q_norm_out = mul(x=l0_q_norm_norm, y=l0_q_norm_rw)[name=string("l0_q_norm_out")];
        tensor<fp16, [1,2,1,4]> l0_k_norm_abs = abs(x=l0_k_4d)[name=string("l0_k_norm_abs")];
        tensor<int32, [1]> l0_k_norm_ax = const()[name=string("l0_k_norm_ax"), val=tensor<int32, [1]>([3])];
        bool l0_k_norm_kd = const()[name=string("l0_k_norm_kd"), val=bool(true)];
        tensor<fp16, [1,2,1,1]> l0_k_norm_maxabs = reduce_max(x=l0_k_norm_abs, axes=l0_k_norm_ax, keep_dims=l0_k_norm_kd)[name=string("l0_k_norm_maxabs")];
        fp16 l0_k_norm_eps = const()[name=string("l0_k_norm_eps"), val=fp16(0.000010)];
        tensor<fp16, [1,2,1,1]> l0_k_norm_safemax = maximum(x=l0_k_norm_maxabs, y=l0_k_norm_eps)[name=string("l0_k_norm_safemax")];
        tensor<fp16, [1,2,1,4]> l0_k_norm_scaled = real_div(x=l0_k_4d, y=l0_k_norm_safemax)[name=string("l0_k_norm_scaled")];
        tensor<fp16, [1,2,1,4]> l0_k_norm_square = square(x=l0_k_norm_scaled)[name=string("l0_k_norm_square")];
        tensor<fp16, [1,2,1,1]> l0_k_norm_meansq = reduce_mean(x=l0_k_norm_square, axes=l0_k_norm_ax, keep_dims=l0_k_norm_kd)[name=string("l0_k_norm_meansq")];
        tensor<fp16, [1,2,1,1]> l0_k_norm_meaneps = add(x=l0_k_norm_meansq, y=l0_k_norm_eps)[name=string("l0_k_norm_meaneps")];
        tensor<fp16, [1,2,1,1]> l0_k_norm_rms = sqrt(x=l0_k_norm_meaneps)[name=string("l0_k_norm_rms")];
        tensor<fp16, [1,2,1,1]> l0_k_norm_scaledrms = mul(x=l0_k_norm_rms, y=l0_k_norm_safemax)[name=string("l0_k_norm_scaledrms")];
        tensor<fp16, [1,2,1,4]> l0_k_norm_norm = real_div(x=l0_k_4d, y=l0_k_norm_scaledrms)[name=string("l0_k_norm_norm")];
        tensor<fp16, [1,1,1,4]> l0_k_norm_rw = const()[name=string("l0_k_norm_rw"), val=tensor<fp16, [1,1,1,4]>(BLOBFILE(path=string("@model_path/weights/l0_k_norm.bin"), offset=uint64(64)))];
        tensor<fp16, [1,2,1,4]> l0_k_norm_out = mul(x=l0_k_norm_norm, y=l0_k_norm_rw)[name=string("l0_k_norm_out")];
        tensor<fp16, [1,2,4,4]> l0_k_cache_read = read_state(input=l0_k_cache_state)[name=string("l0_k_cache_read")];
        tensor<fp16, [1,2,4,4]> l0_v_cache_read = read_state(input=l0_v_cache_state)[name=string("l0_v_cache_read")];
        tensor<fp16, [1,2,3,4]> l0_k_cache_tail = slice_by_index(begin=cache_tail_begin, begin_mask=cache_tail_begin_mask, end=cache_tail_end, end_mask=cache_tail_end_mask, x=l0_k_cache_read)[name=string("l0_k_cache_tail")];
        tensor<fp16, [1,2,3,4]> l0_v_cache_tail = slice_by_index(begin=cache_tail_begin, begin_mask=cache_tail_begin_mask, end=cache_tail_end, end_mask=cache_tail_end_mask, x=l0_v_cache_read)[name=string("l0_v_cache_tail")];
        tensor<fp16, [1,2,4,4]> l0_k_cache_write = concat(axis=cache_axis,interleave=cache_interleave,values=(l0_k_cache_tail,l0_k_norm_out))[name=string("l0_k_cache_write")];
        write_state(data = l0_k_cache_write, input = l0_k_cache_state)[name = string("l0_k_cache_next_write_state")];
        tensor<fp16, [1,2,4,4]> l0_k_cache_next = read_state(input = l0_k_cache_state)[name = string("l0_k_cache_next")];
        tensor<fp16, [1,2,4,4]> l0_v_cache_write = concat(axis=cache_axis,interleave=cache_interleave,values=(l0_v_cache_tail,l0_v_4d))[name=string("l0_v_cache_write")];
        write_state(data = l0_v_cache_write, input = l0_v_cache_state)[name = string("l0_v_cache_next_write_state")];
        tensor<fp16, [1,2,4,4]> l0_v_cache_next = read_state(input = l0_v_cache_state)[name = string("l0_v_cache_next")];
        tensor<fp16, [1,2,1,4]> l0_attn = scaled_dot_product_attention(query=l0_q_norm_out, key=l0_k_cache_next, value=l0_v_cache_next)[name=string("l0_attn")];
        tensor<fp16, [1,1,8]> l0_attn_r = reshape(shape=l0_osh, x=l0_attn)[name=string("l0_attn_r")];
        tensor<fp16, [1,1,8]> l0_attn_o = linear(bias=l0_o_b, weight=l0_o_w, x=l0_attn_r)[name=string("l0_attn_o")];
        tensor<fp16, [1,1,8]> l0_resid1 = add(x=x, y=l0_attn_o)[name=string("l0_resid1")];
        tensor<fp16, [1,1,8]> l0_post_norm_abs = abs(x=l0_resid1)[name=string("l0_post_norm_abs")];
        tensor<int32, [1]> l0_post_norm_ax = const()[name=string("l0_post_norm_ax"), val=tensor<int32, [1]>([2])];
        bool l0_post_norm_kd = const()[name=string("l0_post_norm_kd"), val=bool(true)];
        tensor<fp16, [1,1,1]> l0_post_norm_maxabs = reduce_max(x=l0_post_norm_abs, axes=l0_post_norm_ax, keep_dims=l0_post_norm_kd)[name=string("l0_post_norm_maxabs")];
        fp16 l0_post_norm_eps = const()[name=string("l0_post_norm_eps"), val=fp16(0.000010)];
        tensor<fp16, [1,1,1]> l0_post_norm_safemax = maximum(x=l0_post_norm_maxabs, y=l0_post_norm_eps)[name=string("l0_post_norm_safemax")];
        tensor<fp16, [1,1,8]> l0_post_norm_scaled = real_div(x=l0_resid1, y=l0_post_norm_safemax)[name=string("l0_post_norm_scaled")];
        tensor<fp16, [1,1,8]> l0_post_norm_square = square(x=l0_post_norm_scaled)[name=string("l0_post_norm_square")];
        tensor<fp16, [1,1,1]> l0_post_norm_meansq = reduce_mean(x=l0_post_norm_square, axes=l0_post_norm_ax, keep_dims=l0_post_norm_kd)[name=string("l0_post_norm_meansq")];
        tensor<fp16, [1,1,1]> l0_post_norm_meaneps = add(x=l0_post_norm_meansq, y=l0_post_norm_eps)[name=string("l0_post_norm_meaneps")];
        tensor<fp16, [1,1,1]> l0_post_norm_rms = sqrt(x=l0_post_norm_meaneps)[name=string("l0_post_norm_rms")];
        tensor<fp16, [1,1,1]> l0_post_norm_scaledrms = mul(x=l0_post_norm_rms, y=l0_post_norm_safemax)[name=string("l0_post_norm_scaledrms")];
        tensor<fp16, [1,1,8]> l0_post_norm_norm = real_div(x=l0_resid1, y=l0_post_norm_scaledrms)[name=string("l0_post_norm_norm")];
        tensor<fp16, [1,1,8]> l0_post_norm_rw = const()[name=string("l0_post_norm_rw"), val=tensor<fp16, [1,1,8]>(BLOBFILE(path=string("@model_path/weights/l0_post_norm.bin"), offset=uint64(64)))];
        tensor<fp16, [1,1,8]> l0_post_norm_out = mul(x=l0_post_norm_norm, y=l0_post_norm_rw)[name=string("l0_post_norm_out")];
        tensor<fp16, [1,1,16]> l0_gate = linear(bias=l0_b1, weight=l0_w1, x=l0_post_norm_out)[name=string("l0_gate")];
        tensor<fp16, [1,1,16]> l0_gate_sig = sigmoid(x=l0_gate)[name=string("l0_gate_sig")];
        tensor<fp16, [1,1,16]> l0_gate_act = mul(x=l0_gate, y=l0_gate_sig)[name=string("l0_gate_act")];
        tensor<fp16, [1,1,16]> l0_up = linear(bias=l0_b3, weight=l0_w3, x=l0_post_norm_out)[name=string("l0_up")];
        tensor<fp16, [1,1,16]> l0_mix = mul(x=l0_gate_act, y=l0_up)[name=string("l0_mix")];
        tensor<fp16, [1,1,8]> l0_down = linear(bias=l0_b2, weight=l0_w2, x=l0_mix)[name=string("l0_down")];
        tensor<fp16, [1,1,8]> l0_resid2 = add(x=l0_resid1, y=l0_down)[name=string("l0_resid2")];
        tensor<fp16, [1,1,8]> final_norm_abs = abs(x=l0_resid2)[name=string("final_norm_abs")];
        tensor<int32, [1]> final_norm_ax = const()[name=string("final_norm_ax"), val=tensor<int32, [1]>([2])];
        bool final_norm_kd = const()[name=string("final_norm_kd"), val=bool(true)];
        tensor<fp16, [1,1,1]> final_norm_maxabs = reduce_max(x=final_norm_abs, axes=final_norm_ax, keep_dims=final_norm_kd)[name=string("final_norm_maxabs")];
        fp16 final_norm_eps = const()[name=string("final_norm_eps"), val=fp16(0.000010)];
        tensor<fp16, [1,1,1]> final_norm_safemax = maximum(x=final_norm_maxabs, y=final_norm_eps)[name=string("final_norm_safemax")];
        tensor<fp16, [1,1,8]> final_norm_scaled = real_div(x=l0_resid2, y=final_norm_safemax)[name=string("final_norm_scaled")];
        tensor<fp16, [1,1,8]> final_norm_square = square(x=final_norm_scaled)[name=string("final_norm_square")];
        tensor<fp16, [1,1,1]> final_norm_meansq = reduce_mean(x=final_norm_square, axes=final_norm_ax, keep_dims=final_norm_kd)[name=string("final_norm_meansq")];
        tensor<fp16, [1,1,1]> final_norm_meaneps = add(x=final_norm_meansq, y=final_norm_eps)[name=string("final_norm_meaneps")];
        tensor<fp16, [1,1,1]> final_norm_rms = sqrt(x=final_norm_meaneps)[name=string("final_norm_rms")];
        tensor<fp16, [1,1,1]> final_norm_scaledrms = mul(x=final_norm_rms, y=final_norm_safemax)[name=string("final_norm_scaledrms")];
        tensor<fp16, [1,1,8]> final_norm_norm = real_div(x=l0_resid2, y=final_norm_scaledrms)[name=string("final_norm_norm")];
        tensor<fp16, [1,1,8]> final_norm_rw = const()[name=string("final_norm_rw"), val=tensor<fp16, [1,1,8]>(BLOBFILE(path=string("@model_path/weights/final_norm.bin"), offset=uint64(64)))];
        tensor<fp16, [1,1,8]> final_norm_out = mul(x=final_norm_norm, y=final_norm_rw)[name=string("final_norm_out")];
        tensor<fp16, [12, 8]> lm_head_w = const()[name=string("lm_head_w"), val=tensor<fp16, [12, 8]>(BLOBFILE(path=string("@model_path/weights/lm_head_w.bin"), offset=uint64(64)))];
        tensor<fp16, [12]> lm_head_b = const()[name=string("lm_head_b"), val=tensor<fp16, [12]>(BLOBFILE(path=string("@model_path/weights/lm_head_b.bin"), offset=uint64(64)))];
        tensor<fp16, [1,1,12]> lm_logits = linear(bias=lm_head_b, weight=lm_head_w, x=final_norm_out)[name=string("lm_logits")];
        string to_fp32 = const()[name=string("to_fp32"), val=string("fp32")];
        tensor<fp32, [1,1,12]> y = cast(dtype=to_fp32, x=lm_logits)[name=string("cast_out")];
    } -> (y);
}
